# ==============================================================================
# MACHLOCK CONFIGURATION ENVIRONMENT TEMPLATE
# Research Prototype — Synthetic Cockpit Simulation
# All secrets must remain on server-side and never exposed to client.
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Rime TTS Configuration (PRIMARY Spoken Output Provider)
# Set your actual Rime credentials below. If omitted, demo simulation mode is active.
RIME_API_KEY=your_rime_api_key_here
RIME_ENDPOINT=https://users.rime.ai/v1/rime-tts
RIME_WS_ENDPOINT=wss://users.rime.ai/v1/rime-tts-ws
RIME_MODEL_ID=mist
RIME_VOICE=amber
RIME_LANGUAGE=en
RIME_TRANSPORT=websocket
RIME_AUDIO_FORMAT=pcm_24000
RIME_SAMPLE_RATE=24000

# Speech-To-Text (STT) Provider
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key_here
STT_MODEL=nova-2
STT_LANGUAGE=en-US

# Large Language Model (LLM) Orchestration
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1

# LiveKit Realtime WebRTC
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# Voice Activity Detection (VAD) & Intent Verification Gate
VAD_CONFIDENCE_THRESHOLD=0.65
VAD_ENERGY_THRESHOLD=0.02
ACOUSTIC_MIN_SPEECH_DURATION_MS=120
INTENT_GATE_DEBOUNCE_MS=50
INTERRUPTION_SENSITIVITY=0.75

# Simulation & Fencer Settings
DEFAULT_SIMULATED_TOOL_DELAY_MS=500
SQLITE_DB_PATH=./evidence/machlock_audit.db
ENABLE_PERSISTENT_AUDIT=true
